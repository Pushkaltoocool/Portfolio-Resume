# Copy to .env and fill in. On Vercel, add these in Project Settings → Environment Variables.

ADMIN_SECRET=choose-a-long-random-passcode
IMGBB_API_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_BOOKING_TEMPLATE_ID=

# Locally: path to service account JSON. On Vercel: paste full JSON into GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=

# OAuth "as the owner" — required to send guests a real Google Calendar invite on
# confirm. Create an OAuth 2.0 Client ID (Web application) in Google Cloud.
# The redirect URI must match exactly (dev value shown; use your prod URL on Vercel).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/oauth/callback
# Public site URL, used in notification email links.
SITE_URL=http://localhost:5173

OWNER_NAME=Your Name
OWNER_EMAIL=you@example.com
GOOGLE_CALENDAR_IDS=you@example.com
BOOKING_CALENDAR_ID=you@example.com
BOOKING_TIMEZONE=Asia/Singapore
BOOKING_START_HOUR=9
BOOKING_END_HOUR=21
BOOKING_MIN_NOTICE_HOURS=2
BOOKING_MAX_DAYS_AHEAD=60
